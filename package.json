{
  "name": "parousia-activities",
  "private": true,
  "description": "A collection of activities for the Parousia project",
  "homepage": "https://parousia.abadima.dev",
  "type": "module",
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run validate && bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "validate": "bun run tools/validate.ts",
    "test": "bun test",
    "test:report": "bun run tests/report.ts",
    "fixture": "bun run tools/fixture.ts",
    "dns-check": "bun run tools/dns-check.ts",
    "api-check": "bun run tools/api-check.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
