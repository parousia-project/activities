{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://github.com/parousia-project/activities/blob/main/schemas/metadata.json",
  "title": "Parousia Activity metadata",
  "description": "What a native Parousia Activity is and which pages it's for (Activity API version 1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "id", "name", "description", "version", "authors", "matches"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "apiVersion": {
      "description": "The Activity API this Activity is written against.",
      "const": 1
    },
    "id": {
      "description": "The folder name (websites/<letter>/<Name>/) in lowercase, words joined by \"-\": YouTube Music is youtube-music.",
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "name": {
      "description": "The site or service, as people know it.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "description": {
      "description": "One sentence on what it shows, for the extension's Activities page.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "version": {
      "description": "MAJOR.MINOR.PATCH; raise it with every change.",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "github": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,39}$"
          }
        }
      }
    },
    "matches": {
      "description": "The pages it runs on, as WebExtension match patterns (\"https://example.com/*\", \"https://*.example.com/watch*\"). Never every site.",
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^(\\*|https?)://(\\*\\.)?[a-z0-9-]+(\\.[a-z0-9-]+)*/.*$"
      }
    },
    "discordClientId": {
      "description": "The Discord Application it shows as. Without one, it shows as Parousia.",
      "type": "string",
      "pattern": "^\\d{17,20}$"
    },
    "icon": {
      "description": "Its icon, an https image URL, shown in the extension's Activities page.",
      "type": "string",
      "pattern": "^https://",
      "maxLength": 256
    },
    "data": {
      "description": "Page data it takes beyond the URL and title: what's playing (media), images of it (thumbnails). Each needs the site granted, and can be switched off.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["media", "thumbnails"]
      }
    },
    "settings": {
      "description": "Options for the Activity's page in the extension; detect() receives their values.",
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "type", "default"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "type": {
            "enum": ["boolean", "choice", "text", "number"]
          },
          "default": {
            "description": "true or false; the index of a choice; text; or a number.",
            "type": ["boolean", "number", "string"]
          },
          "choices": {
            "type": "array",
            "minItems": 2,
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "placeholder": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "when": {
            "description": "Show this setting only while each named setting has the given value.",
            "type": "object",
            "additionalProperties": {
              "type": ["boolean", "number", "string"]
            }
          }
        }
      }
    }
  }
}
